var PER_PAGE = 6;

function createReviewForm() {
  var form = FormApp.create('SoilSense ZM: scenario review');
  form.setDescription(
    'Thank you for reviewing SoilSense ZM. There are ' + DATA.length + ' made-up farm situations (not real farmers).\n\n' +
    'Part 1: write what YOU would advise for each situation.\n' +
    'Part 2: read what the system advises and say whether you agree.\n\n' +
    'Please finish Part 1 before reading Part 2, so your advice is your own. Short answers are fine. ' +
    '1 lima = 0.25 ha. pH is in water unless it says CaCl2. About 45 minutes; progress is not saved if you close the page.');
  form.setCollectEmail(false);
  form.setProgressBar(true);
  form.setConfirmationMessage('Thank you! Your review will be used to evaluate SoilSense ZM.');

  var pages = Math.ceil(DATA.length / PER_PAGE);
  for (var p = 0; p < pages; p++) {
    var part = DATA.slice(p * PER_PAGE, (p + 1) * PER_PAGE);
    form.addPageBreakItem().setTitle('Part 1: your advice (' + (p + 1) + ' of ' + pages + ')')
        .setHelpText('What would you advise? Lime, fertiliser, which crops. Short answers are fine.');
    part.forEach(function (s) {
      form.addParagraphTextItem().setTitle('A' + s.n + '. Situation ' + s.n + ': your advice').setHelpText(s.situation);
    });
  }
  for (var q = 0; q < pages; q++) {
    var part2 = DATA.slice(q * PER_PAGE, (q + 1) * PER_PAGE);
    form.addPageBreakItem().setTitle('Part 2: the system\'s advice (' + (q + 1) + ' of ' + pages + ')')
        .setHelpText('Do you agree with what SoilSense ZM advises?');
    part2.forEach(function (s) {
      form.addMultipleChoiceItem().setTitle('R' + s.n + '. Situation ' + s.n + ': do you agree?')
          .setHelpText(s.situation + '\n\nSYSTEM ADVICE:\n' + s.advice)
          .setChoiceValues(['Agree', 'Partly', 'Disagree']);
      form.addParagraphTextItem().setTitle('C' + s.n + '. Situation ' + s.n + ': if not Agree, what is wrong?');
    });
  }
  var sheet = SpreadsheetApp.create('SoilSense ZM: scenario review (responses)');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());
  Logger.log('SEND THIS LINK: ' + form.shortenFormUrl(form.getPublishedUrl()));
  Logger.log('Responses spreadsheet: ' + sheet.getUrl());
}
